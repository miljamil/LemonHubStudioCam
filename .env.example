# --- Backend ---
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000

# Google Drive (single business-owner account, OAuth refresh token flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_LINKED_EMAIL=

# Default storage mode used before the user picks one in the UI.
# Options: local | google-drive | youtube. Once the user changes it in the
# app, the saved value in the DB wins over this default.
STORAGE_MODE=

# SMTP for outbound email (Gmail app-password works)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="StudioCam <no-reply@studiocam.local>"

# Max recording chunk length (seconds). 30 min default.
MAX_CHUNK_SECONDS=1800
