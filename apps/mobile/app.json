{
  "expo": {
    "name": "StudioCam",
    "slug": "studiocam",
    "version": "0.2.0",
    "scheme": "com.studiocam.app",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.studiocam.app",
      "infoPlist": {
        "NSCameraUsageDescription": "StudioCam needs camera access to record video.",
        "NSMicrophoneUsageDescription": "StudioCam needs microphone access to record audio.",
        "NSPhotoLibraryAddUsageDescription": "StudioCam saves recordings to your photo library."
      }
    },
    "android": {
      "package": "com.studiocam.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": ["expo-camera", "expo-media-library", "expo-secure-store"],
    "extra": {
      "backendUrl": "https://lemonhubstudiocam.onrender.com",
      "googleClientId": "434149043545-b9ehq5md61vp1mck4f1tbr27b4arekor.apps.googleusercontent.com"
    }
  }
}
